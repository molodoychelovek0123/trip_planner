{
  "manifest_version": 3,
  "name": "Trip Planner Exporter",
  "version": "1.0",
  "description": "Export Google Maps lists to Trip Planner",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "*://www.google.com/maps/*",
    "*://localhost/*"
  ]
}
